      "capabilities": ["text.generate"],
      "recommendedFor": ["text.generate"],
      "credentialModes": ["token_plan"],
      "availability": "documented",
      "execution": "sync",
      "parameters": {
        "text.generate": {
          "type": "object",
          "properties": {
            "prompt": {
              "type": "string",
              "title": "提示词",
              "minLength": 1
            },
            "temperature": {
              "type": "number",
              "title": "随机性",
              "minimum": 0,
              "maximum": 2,
              "default": 0.7
            },
            "max_tokens": {
              "type": "integer",
              "title": "最大输出 Token",
              "minimum": 1,
              "maximum": 8192,
              "default": 2048
            }
          },
          "required": ["prompt"],
          "additionalProperties": false
        }
      },
