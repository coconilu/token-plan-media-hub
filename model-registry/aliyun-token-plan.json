    {
      "id": "qwen3-tts-vc-2026-01-22",
      "capabilities": ["voice.clone", "speech.synthesize_with_clone"],
      "recommendedFor": ["voice.clone", "speech.synthesize_with_clone"],
      "credentialModes": ["dashscope"],
      "availability": "probe_required",
      "execution": "sync",
      "parameters": {
        "voice.clone": {
          "type": "object",
          "properties": {
            "reference_audio": {
              "type": "string",
              "title": "参考音频路径",
              "minLength": 1
            },
            "consent": {
              "type": "boolean",
              "title": "我确认拥有该声音或已获得明确授权"
            },
            "name": {
              "type": "string",
              "title": "本地音色别名",
              "description": "仅支持英文字母、数字和下划线，最多 16 个字符。",
              "default": "my_voice",
              "minLength": 1,
              "maxLength": 16,
              "pattern": "^[A-Za-z0-9_]+$"
            },
            "language": {
              "type": "string",
              "title": "语言",
              "default": "Auto"
            }
          },
          "required": ["reference_audio", "consent", "name"],
          "additionalProperties": false
        },
        "speech.synthesize_with_clone": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "title": "合成文本",
              "minLength": 1
            },
            "voice_alias": {
              "type": "string",
              "title": "本地音色别名",
              "minLength": 1
            },
            "language": {
              "type": "string",
              "title": "语言",
              "default": "Auto"
            }
          },
          "required": ["text", "voice_alias"],
          "additionalProperties": false
        }
      },
